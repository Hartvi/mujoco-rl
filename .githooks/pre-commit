#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [[ -n "${VIRTUAL_ENV:-}" && -x "${VIRTUAL_ENV}/bin/python" ]]; then
    python_bin="${VIRTUAL_ENV}/bin/python"
elif [[ -x "/home/hartvi/venvs/ros2-torch/bin/python" ]]; then
    python_bin="/home/hartvi/venvs/ros2-torch/bin/python"
else
    python_bin="python3"
fi

echo "[pre-commit] Running bowling environment tests with ${python_bin}"
"${python_bin}" -m unittest -v test_bowling_environment.py
